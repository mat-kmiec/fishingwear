<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-slider-image-table" author="fishingwear-admin">
        <createTable tableName="slider_image">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="original_file_name" type="VARCHAR(255)"/>

            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-slider-table" author="fishingwear-admin">
        <createTable tableName="slider">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-slider-item-table" author="fishingwear-admin">
        <createTable tableName="slider_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="title" type="VARCHAR(255)"/>

            <column name="description" type="TEXT"/>

            <column name="sort_order" type="INT"/>

            <column name="slider_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="slider_image_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="slider_item"
                                 baseColumnNames="slider_id"
                                 constraintName="fk_slider_item_slider"
                                 referencedTableName="slider"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="slider_item"
                                 baseColumnNames="slider_image_id"
                                 constraintName="fk_slider_item_image"
                                 referencedTableName="slider_image"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>