    <!-- === PRODUKT 1: T-shirt Basic White === -->
    <changeSet id="3-insert-product" author="dev">
        <insert tableName="product">
            <column name="name" value="T-shirt Basic White"/>
            <column name="description" value="Biały, klasyczny T-shirt z miękkiej bawełny. Idealny na co dzień."/>
            <column name="details" value="100% bawełna organiczna, gramatura 180 g/m2, krój regular fit"/>
            <column name="price" valueNumeric="59.99"/>
            <column name="sku" value="TSHIRT-WHITE-001"/>
            <column name="slug" value="tshirt-basic-white"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="4-assign-product-category" author="dev">
        <insert tableName="product_category">
            <column name="product_id" valueNumeric="1"/>
            <column name="category_id" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="5-insert-product-images" author="dev">
        <insert tableName="product_image">
            <column name="product_id" valueNumeric="1"/>
            <column name="image_url" value="/products/1/tshirt.png"/>
            <column name="is_main" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="6-insert-product-variants" author="dev">
        <insert tableName="product_variant">
            <column name="product_id" valueNumeric="1"/>
